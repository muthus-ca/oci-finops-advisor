{
  "title": "Query published OCI FinOps facts",
  "description": "Input schema for the optional function query action. Agent tool registration is separate. Monetary results are partitioned by currency and usage by service/SKU/unit. Dates are UTC, end exclusive.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "start_date",
    "end_date",
    "metric",
    "group_by"
  ],
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "query"
      ]
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "metric": {
      "type": "string",
      "enum": [
        "cost",
        "usage"
      ]
    },
    "group_by": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "date",
          "currency",
          "compartment_id",
          "compartment_path",
          "service",
          "region",
          "sku_part_number",
          "unit"
        ]
      }
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currency": {
          "type": "string"
        },
        "compartment_id": {
          "type": "string"
        },
        "compartment_path": {
          "type": "string"
        },
        "service": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "sku_part_number": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        }
      }
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "default": 20
    },
    "order": {
      "type": "string",
      "enum": [
        "ascending",
        "descending"
      ],
      "default": "descending"
    }
  }
}
